class TestMapWidgetErrorHandling:
    """Test error handling approach."""
    
    def test_map_widget_validates_inputs(self):
        """MapWidget should validate constructor inputs."""
        # Test None track_manager
        with pytest.raises(ValueError):
            MapWidget(None, Mock(), Mock())
        
        # Test None mbtiles_provider
        with pytest.raises(ValueError):
            MapWidget(Mock(), None, Mock())
        
        # Test None logger
        with pytest.raises(ValueError):
            MapWidget(Mock(), Mock(), None)


class TestMapStateEnum:
    """Test MapState enumeration values."""
    
    def test_all_states_have_values(self):
        """Should have all required states."""
        states = [MapState.UNINITIALIZED, MapState.LOADING, MapState.READY, MapState.ERROR]
        for state in states:
            assert state.value is not None
            assert isinstance(state.value, str)


